#include <stdio.h>
#define INF 999

int main()
{
    int n, cost[10][10], dist[10][10], next[10][10];

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    printf("Enter cost matrix (use 999 for no link):\n");

    for (int i=0;i<n;i++)
        for (int j=0;j<n;j++)
        {
            scanf("%d",&cost[i][j]);
            dist[i][j]=cost[i][j];

            if (i!=j && cost[i][j]!=INF)
                next[i][j]=j;
            else
                next[i][j]=-1;
        }

    for (int k=0;k<n;k++)
        for (int i=0;i<n;i++)
            for (int j=0;j<n;j++)
                if (dist[i][k]!=INF && dist[k][j]!=INF &&
                    dist[i][k]+dist[k][j] < dist[i][j])
                {
                    dist[i][j]=dist[i][k]+dist[k][j];
                    next[i][j]=next[i][k];
                }

    for (int i=0;i<n;i++)
    {
        printf("\nRouting table for Node %d\n",i+1);
        printf("Destination\tCost\tNext Hop\n");

        for (int j=0;j<n;j++)
        {
            printf("%d\t\t%d\t",j+1,dist[i][j]);

            if (next[i][j]==-1)
                printf("-\n");
            else
                printf("%d\n",next[i][j]+1);
        }
    }

    return 0;
}




